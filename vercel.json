{
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 6 * * *"
    },
    { "path": "/api/cron/automazioni?utc=13", "schedule": "0 13 * * *" },
    { "path": "/api/cron/automazioni?utc=14", "schedule": "0 14 * * *" },
    { "path": "/api/cron/automazioni?utc=19", "schedule": "0 19 * * *" },
    { "path": "/api/cron/automazioni?utc=20", "schedule": "0 20 * * *" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/registrazione/(.*)",
      "headers": [
        { "key": "Clear-Site-Data", "value": "\"cache\", \"storage\"" }
      ]
    }
  ]
}
